<?xml version="1.0" encoding="UTF-8"?>
<!--
  Pigeonhole — Outlook add-in manifest.

  For local development, replace https://addin.pigeonhole.email with
  https://localhost:3000 (run `npm run dev` in addin/) and sideload this
  file: Outlook > Get Add-ins > My add-ins > Add a custom add-in.
  See docs/SETUP.md.
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <Id>7f1c2b3a-9d4e-4f6a-8c5b-2e7d9a0f4c11</Id>
  <Version>1.0.0</Version>
  <ProviderName>Pigeonhole</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Pigeonhole"/>
  <Description DefaultValue="Files your email where you would. Learns your folder habits locally — private, instant, no AI tokens."/>
  <IconUrl DefaultValue="https://addin.pigeonhole.email/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://addin.pigeonhole.email/assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://pigeonhole.email/support"/>

  <AppDomains>
    <AppDomain>https://pigeonhole.email</AppDomain>
    <AppDomain>https://login.microsoftonline.com</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.8"/>
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://addin.pigeonhole.email/src/taskpane.html"/>
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteMailbox</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.8">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>

      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="phGroup">
                  <Label resid="GroupLabel"/>
                  <Control xsi:type="Button" id="phOpenPane">
                    <Label resid="OpenPaneLabel"/>
                    <Supertip>
                      <Title resid="OpenPaneLabel"/>
                      <Description resid="OpenPaneTip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon16"/>
                      <bt:Image size="32" resid="Icon32"/>
                      <bt:Image size="80" resid="Icon80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="TaskpaneUrl"/>
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>

      <Resources>
        <bt:Images>
          <bt:Image id="Icon16" DefaultValue="https://addin.pigeonhole.email/assets/icon-16.png"/>
          <bt:Image id="Icon32" DefaultValue="https://addin.pigeonhole.email/assets/icon-32.png"/>
          <bt:Image id="Icon80" DefaultValue="https://addin.pigeonhole.email/assets/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="TaskpaneUrl" DefaultValue="https://addin.pigeonhole.email/src/taskpane.html"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="GroupLabel" DefaultValue="Pigeonhole"/>
          <bt:String id="OpenPaneLabel" DefaultValue="File with Pigeonhole"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="OpenPaneTip" DefaultValue="See the five folders this email most likely belongs in, and file it in one click."/>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
