# Copy to .env and fill in what you use. Everything is optional — the app
# runs fully without any of it (email logs to console, supporter tier uses
# the demo toggle). .gitignore already excludes .env*.

# --- Core ---
# Public URL of the site; used to build links in emails and Stripe redirects.
APP_URL=http://localhost:3000
# Extra hosts allowed to submit forms when running behind a proxy/domain.
# Codespaces (*.app.github.dev) and Gitpod are already trusted.
ALLOWED_ORIGINS=comn.one,www.comn.one
# Where the SQLite database lives (default: ./data)
#COMN_DATA_DIR=/var/lib/comn

# --- Email (password reset + reminder emails) ---
# Gmail: enable 2-Step Verification, then create an App Password.
# The normal account password will NOT work over SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=hello.comn.one@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM="Comn.one <hello.comn.one@gmail.com>"

# --- Scheduled reminders ---
# Shared secret for GET /api/cron/remind (see README for the cron line).
CRON_SECRET=generate-a-long-random-string

# --- Stripe (supporter subscription + tip link) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: a Stripe Payment Link for pay-what-you-want tips, shown on /support
STRIPE_PAYMENT_LINK=https://buy.stripe.com/...
